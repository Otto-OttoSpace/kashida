{
  "name": "kashida",
  "version": "0.6.1",
  "description": "Catch the typography mistakes that break COMPLEX-SCRIPT rendering — Arabic & the RTL-cursive family, Indic, SE-Asian, CJK, Hebrew. Static AST/PostCSS tier (letter/word-spacing, tight leading, tiny size, uppercase, Latin-only fonts, ligature-off, bidi-override, stray ZWNJ), plus optional HarfBuzz `--render` (tofu / fake-Arabic-font / unattached marks) and a live `--url` Chromium tier. Per-family gating so Hebrew/CJK never get a false letter-spacing flag. Report-only, with an MCP server. Part of OttoSpace.",
  "bin": {
    "kashida": "bin/kashida.js",
    "arabitype": "bin/kashida.js",
    "kashida-mcp": "mcp/kashida-mcp.js"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/run.js test/font-fix.test.js test/mcp-security.test.js"
  },
  "keywords": [
    "arabic",
    "typography",
    "rtl",
    "i18n",
    "tashkeel",
    "fonts",
    "linter",
    "harfbuzz",
    "shaping",
    "scripts",
    "indic",
    "cjk",
    "hebrew",
    "ai",
    "cursor",
    "claude",
    "arabitype"
  ],
  "author": "Othmane Morad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otto-OttoSpace/kashida.git"
  },
  "homepage": "https://github.com/Otto-OttoSpace/kashida#readme",
  "bugs": {
    "url": "https://github.com/Otto-OttoSpace/kashida/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "assets",
    "action.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@ottospace/rtl-scripts": "git+https://github.com/Otto-OttoSpace/rtl-scripts.git#62b34f3329002fa78fcde537338b6556dae8a5d9",
    "postcss": "^8.5.23",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9"
  },
  "optionalDependencies": {
    "fontkit": "^2.0.4",
    "harfbuzzjs": "^0.10.3",
    "playwright": "^1.48.0",
    "wawoff2": "^2.0.1"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Otto-OttoSpace"
  }
}
